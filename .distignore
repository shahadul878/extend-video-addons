# Files and directories excluded from WordPress.org / GitHub release zips.
# Used by .github/workflows/release.yml and git archive (.gitattributes).

# Version control
.git
.github
.gitignore
.gitattributes
.svn
.svnignore

# This file
.distignore

# WordPress.org SVN assets (banners, icons, screenshots) — deploy to /assets, not trunk
.wordpress-org

