.idea
.vscode
*.sublime-*
.DS_Store
Thumbs.db
*~
*.swp
*.bak
*.tmp

# Dev config
.editorconfig
.eslintignore
.eslintrc
.eslintrc.js
.eslintrc.json
.stylelintignore
.stylelintrc
.prettierrc
.phpcs.xml
.phpcs.xml.dist
phpcs.xml
phpcs.xml.dist
